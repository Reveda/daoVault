# Leave empty in local development; Vite proxies /api to localhost:5000.
# VITE_API_BASE_URL=https://api.example.com/api/v1

# Use 97 for BSC Testnet testing or 56 for BSC Mainnet production.
# VITE_BSC_CHAIN_ID=97
# VITE_BSC_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# Add these only after DAOvaultActivation.sol is deployed and verified.
# VITE_USDT_CONTRACT_ADDRESS=0xVerifiedTokenContract
# VITE_PAYMENT_CONTRACT_ADDRESS=0xDeployedPaymentContract
# VITE_ACTIVATION_AMOUNT_USDT=300
# Real-money (mainnet) payments stay OFF unless this is exactly true. Set it only at launch.
# VITE_ALLOW_MAINNET_PAYMENTS=false
