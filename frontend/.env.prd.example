# Replace YOUR_BACKEND_SERVICE with the actual Render backend hostname.
VITE_API_BASE_URL=https://YOUR_BACKEND_SERVICE.onrender.com/api/v1
VITE_BSC_CHAIN_ID=56
VITE_BSC_RPC_URL=https://bsc-dataseed.binance.org/
VITE_USDT_CONTRACT_ADDRESS=0xYOUR_VERIFIED_USDT_CONTRACT
VITE_PAYMENT_CONTRACT_ADDRESS=0xYOUR_DEPLOYED_PAYMENT_CONTRACT
VITE_ACTIVATION_AMOUNT_USDT=300
# Real-money payments stay OFF until launch day; set to true only then.
VITE_ALLOW_MAINNET_PAYMENTS=false
# Launch date for the landing countdown (ISO 8601). Same moment for every visitor.
VITE_LAUNCH_DATE=2026-10-22T00:00:00+05:30
