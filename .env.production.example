# docker-compose.prod.yml values. Copy to `.env.production` ON THE SERVER (never commit it):
#   cp .env.production.example .env.production && chmod 600 .env.production

# Database password (letters/numbers only, it goes into a URL). Generate: openssl rand -hex 32
POSTGRES_PASSWORD=

# Redis password (shared rate limits of the API copies). Generate: openssl rand -hex 32
REDIS_PASSWORD=

# API copies (Node uses one core each). 4-core VPS: 3 (the 4th core serves Postgres / Nginx).
BACKEND_REPLICAS=3
# Prisma connection pool per backend replica. Keep the total below PostgreSQL max_connections.
DB_CONNECTION_LIMIT=10
WORKER_DB_CONNECTION_LIMIT=5
DB_POOL_TIMEOUT_SECONDS=10
DB_CONNECT_TIMEOUT_SECONDS=10

# Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> token (public hostname -> http://web:8080)
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_PUBLIC_HOSTNAME=daovault.io

# Instant withdrawals (payout signer service, profile "payouts"; DOCKER.md "Instant withdrawals").
# Empty = withdrawals stay closed ("Withdrawals are not open yet"). There is no admin review.
# Shared secret between the API and the signer. Generate: openssl rand -hex 32
PAYOUT_SIGNER_TOKEN=
# http://signer:7000 once the signer runs (--profile payouts); empty = no signer
PAYOUT_SIGNER_URL=
# MUST match the backend's BSC_CHAIN_ID and PAYOUT_CONTRACT_ADDRESS (97 testnet / 56 mainnet)
SIGNER_CHAIN_ID=97
SIGNER_PAYOUT_CONTRACT=
# BSC USDT has 18 decimals
SIGNER_TOKEN_DECIMALS=18
# the signer's own caps (USDT); keep them >= the contract's maxPerClaim / dailyLimit
SIGNER_MAX_PER_CLAIM_USD=1000
SIGNER_MAX_PER_DAY_USD=10000
SIGNER_MAX_REQUESTS_PER_MINUTE=120

# Off-site backup (profile "offsite"; DOCKER.md "Off-site backup"): rclone crypt remote name + days kept there
OFFSITE_REMOTE=daovault-crypt:
OFFSITE_KEEP_DAYS=30

# Days of daily database backups kept in ./backups
BACKUP_KEEP_DAYS=7

# Website build (VITE_* are PUBLIC: they are inside the website code; never put a secret here)
# 97 = BSC Testnet, 56 = BSC Mainnet
VITE_BSC_CHAIN_ID=97
VITE_BSC_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
VITE_USDT_CONTRACT_ADDRESS=
VITE_PAYMENT_CONTRACT_ADDRESS=
VITE_ACTIVATION_AMOUNT_USDT=300
# Real-money payments stay OFF until launch day: set true only when the owner says it is launch time
VITE_ALLOW_MAINNET_PAYMENTS=false
# Landing countdown (ISO 8601)
VITE_LAUNCH_DATE=2026-10-22T00:00:00+05:30
