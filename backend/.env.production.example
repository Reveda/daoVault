# API settings for docker-compose.prod.yml. Copy to backend/.env.production ON THE SERVER (never commit it):
#   cp backend/.env.production.example backend/.env.production && chmod 600 backend/.env.production
# NODE_ENV, PORT, TRUST_PROXY and DATABASE_URL are set by docker-compose.prod.yml: do not add them here.

API_PREFIX=/api/v1
# The site's public address(es), https only, comma-separated
FRONTEND_URL=https://daovault.io
# Long random secret, NEW for production. Generate: openssl rand -hex 48
JWT_SECRET=

# 97 = BSC Testnet, 56 = BSC Mainnet (a paid RPC is more reliable on mainnet)
BSC_CHAIN_ID=97
BSC_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
# Comma-separated fallbacks, in priority order. Use at least two independent providers in production.
BSC_RPC_URLS=

USDT_CONTRACT_ADDRESS=
PAYMENT_CONTRACT_ADDRESS=
ACTIVATION_AMOUNT_USDT=300
# Pre-launch marketing: members register, get their ID and build their team; "Pay & Activate"
# shows on the dashboard only from this moment (ISO 8601 with offset). Empty = 10 Nov 2026 00:00 IST
# (owner, 2026-10-13). To open at once (testnet testing) set a past date: 2026-01-01T00:00:00+05:30
PAYMENTS_OPEN_AT=2026-11-10T00:00:00+05:30

# Monitoring (DOCKER.md B13): problems are written to the server log as "[alert]" lines
# payout float that triggers "float low" (USDT)
PAYOUT_FLOAT_ALERT_USD=500
# Company root = the activation contract's treasury (exactly the same address)
COMPANY_WALLET_ADDRESS=
# Admin panel wallets (normal wallets that can sign in), comma-separated
ADMIN_WALLETS=

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=1200
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=600
AUTH_WALLET_RATE_LIMIT_MAX=20
FINANCIAL_RATE_LIMIT_WINDOW_MS=60000
FINANCIAL_RATE_LIMIT_MAX=200
LOG_REQUESTS=true
# log detail: info (production default) | warn | error | debug. Logs are JSON lines (pino), secrets redacted
LOG_LEVEL=info

WITHDRAWAL_MIN_USD=10
WITHDRAWAL_FEE_PERCENT=5

# Instant withdrawals. Leave empty for admin-reviewed withdrawals.
PAYOUT_CONTRACT_ADDRESS=
# TESTNET (97) ONLY: the fundless voucher signer key. The API refuses to start with it on mainnet.
# PAYOUT_SIGNER_TESTNET_KEY=
PAYOUT_VOUCHER_MINUTES=15

# Background worker (service `worker`): reads the payment contract's events so no payment is missed.
# Block the activation contract was deployed in (BscScan -> contract -> first transaction). Empty = new blocks only.
INDEXER_START_BLOCK=
# Needs an RPC that allows eth_getLogs: bnbchain.org / binance.org public dataseeds refuse it.
# Testnet: https://bsc-testnet-rpc.publicnode.com   Mainnet: a paid RPC (or https://bsc-rpc.publicnode.com)
INDEXER_RPC_URL=https://bsc-testnet-rpc.publicnode.com
# Optional comma-separated indexer fallbacks; BSC_RPC_URLS are used when this is empty.
INDEXER_RPC_URLS=
INDEXER_CONFIRMATIONS=3
INDEXER_BLOCK_CHUNK=2000
INDEXER_INTERVAL_SECONDS=15
