generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PackageStatus {
  ACTIVE
  CAPPED
  EXPIRED
}

/// How a package entered the system. Only ON_CHAIN packages are public activity events.
enum PackageSource {
  ON_CHAIN
  POWER_BUSINESS
}

/// Binary placement (owner, 2026-10-17): the side of the member above that a member takes
enum PlacementSide {
  LEFT
  RIGHT
}

enum EarningType {
  LEVEL_COMMISSION
  RANK_REWARD
  /// 10 paid directs within 3 / 7 days of joining (plan.ts FAST_START); level = the days (3 or 7)
  FAST_START_BONUS
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
}

model User {
  id                 String         @id @default(uuid()) @db.Uuid
  walletAddress      String         @unique @map("wallet_address") @db.VarChar(42)
  referralCode       String         @unique @map("referral_code") @db.VarChar(16)
  /// SPONSOR (referral tree: who invited whom): directs, level unlock and the 20-level income
  uplineId           String?        @map("upline_id") @db.Uuid
  activeDirectsCount Int            @default(0) @map("active_directs_count")
  currentRank        Int            @default(0) @map("current_rank")
  /// PLACEMENT (binary tree, owner 2026-10-17): the member this one sits under and on which side.
  /// Chosen once when joining, never changed. Team business, legs and ranks follow this tree.
  placementId        String?        @map("placement_id") @db.Uuid
  placementSide      PlacementSide? @map("placement_side")
  /// counted packages (1 DAO each) in this member's LEFT / RIGHT placement team; own package not included
  leftVolume         Int            @default(0) @map("left_volume")
  rightVolume        Int            @default(0) @map("right_volume")
  /// left_volume + right_volume
  teamVolume         Int            @default(0) @map("team_volume")
  /// invite code of the LATEST referral link this wallet opened before paying (owner, 2026-10-09).
  /// Saved on the server so the member can pay from any browser or wallet app; the real
  /// upline link is still made at activation, from the sponsor in the on-chain payment.
  pendingSponsorCode String?        @map("pending_sponsor_code") @db.VarChar(16)
  createdAt          DateTime       @default(now()) @map("created_at")
  upline             User?          @relation("UserUpline", fields: [uplineId], references: [id])
  downline            User[]        @relation("UserUpline")
  placement          User?          @relation("UserPlacement", fields: [placementId], references: [id])
  placedBelow        User[]         @relation("UserPlacement")
  packages           Package[]
  receivedEarnings   Earning[]      @relation("EarningRecipient")
  sourceEarnings     Earning[]      @relation("EarningSource")
  withdrawals        Withdrawal[]
  powerBusinesses    PowerBusiness[] @relation("PowerBusinessOwner")

  @@index([uplineId])
  /// one member per spot: two members can never take the same LEFT / RIGHT place
  @@unique([placementId, placementSide])
  @@map("users")
}

model Package {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  packageAmount   Decimal       @default(300) @map("package_amount") @db.Decimal(18, 2)
  totalEarned     Decimal       @default(0) @map("total_earned") @db.Decimal(18, 2)
  maxCapLimit     Decimal       @default(7500) @map("max_cap_limit") @db.Decimal(18, 2)
  status          PackageStatus @default(ACTIVE)
  source          PackageSource @default(ON_CHAIN)
  activationTxHash String       @unique @map("activation_tx_hash") @db.VarChar(66)
  createdAt       DateTime      @default(now()) @map("created_at")
  /// when the member paid ON-CHAIN (the block time of Activated / ToppedUp; owner 2026-10-18): the fast-start
  /// clock uses it, so a late record never costs a bonus. Null on older rows: created_at stands in.
  paidAt          DateTime?     @map("paid_at")
  /// set when the plan queue has paid its commissions and added it to the team volumes
  /// (plan_events); only counted packages make DAO volume / leg totals
  countedAt       DateTime?     @map("counted_at")
  user            User          @relation(fields: [userId], references: [id])
  earnings        Earning[]

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("packages")
}

/// Display-only/admin-assigned business. It is deliberately separate from Package so it cannot
/// enter the on-chain activation, plan queue, level commission, rank reward, or withdrawal flow.
model PowerBusiness {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  amountUsd  Decimal  @map("amount_usd") @db.Decimal(18, 2)
  reference  String   @unique @db.VarChar(100)
  note       String?  @db.VarChar(280)
  /// the member's side that receives the whole amount (one side only)
  side       PlacementSide @default(LEFT)
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation("PowerBusinessOwner", fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@map("power_businesses")
}

/// Plan queue (owner, 2026-10-13: launch-day scaling). A payment only records its package and
/// one event; ONE runner (Postgres advisory lock) then pays the 20 levels, directs, team volume
/// (batched: one update per upline per batch) and ranks, in payment order. Many payments at
/// once never fight over the same upline rows.
model PlanEvent {
  id           BigInt    @id @default(autoincrement())
  packageId    String    @unique @map("package_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// first package (activation): the sponsor gains an active direct; a top-up does not
  isActivation Boolean   @map("is_activation")
  amountCents  Int       @map("amount_cents")
  createdAt    DateTime  @default(now()) @map("created_at")
  processedAt  DateTime? @map("processed_at")

  @@index([processedAt, id])
  @@map("plan_events")
}

model Earning {
  id          String      @id @default(uuid()) @db.Uuid
  recipientId String      @map("recipient_id") @db.Uuid
  sourceId    String      @map("source_id") @db.Uuid
  packageId   String      @map("package_id") @db.Uuid
  type        EarningType
  level       Int?
  percentage  Decimal?    @db.Decimal(5, 2)
  amountUsd   Decimal     @map("amount_usd") @db.Decimal(18, 2)
  createdAt   DateTime    @default(now()) @map("created_at")
  recipient   User        @relation("EarningRecipient", fields: [recipientId], references: [id])
  source      User        @relation("EarningSource", fields: [sourceId], references: [id])
  package     Package     @relation(fields: [packageId], references: [id])

  @@index([recipientId, createdAt])
  @@index([packageId])
  @@index([type, createdAt])
  @@map("earnings")
}

model Withdrawal {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  grossAmount       Decimal          @map("gross_amount") @db.Decimal(18, 2)
  feeAmount         Decimal          @map("fee_amount") @db.Decimal(18, 2)
  netAmount         Decimal          @map("net_amount") @db.Decimal(18, 2)
  destinationWallet String           @map("destination_wallet") @db.VarChar(42)
  status            WithdrawalStatus @default(PENDING)
  payoutTxHash      String?          @unique @map("payout_tx_hash") @db.VarChar(66)
  reviewedBy        String?          @map("reviewed_by") @db.VarChar(42)
  reviewedAt        DateTime?        @map("reviewed_at")
  rejectReason      String?          @map("reject_reason") @db.VarChar(280)
  /// instant payout voucher (DAOvaultPayout): id = keccak256(withdrawal id), amount in token units
  voucherId         String?          @unique @map("voucher_id") @db.VarChar(66)
  voucherAmount     String?          @map("voucher_amount") @db.VarChar(80)
  voucherDeadline   DateTime?        @map("voucher_deadline")
  voucherSignature  String?          @map("voucher_signature") @db.VarChar(140)
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at")
  user              User             @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([status, updatedAt])
  @@index([status, voucherId, userId])
  @@index([status, voucherDeadline])
  @@index([status, reviewedAt])
  @@map("withdrawals")
}

/// One-time sign-in challenge per wallet (wallet signature login)
model AuthNonce {
  walletAddress String   @id @map("wallet_address") @db.VarChar(42)
  message       String
  expiresAt     DateTime @map("expires_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([expiresAt])

  @@map("auth_nonces")
}

/// Sign-in session version per wallet. Every token carries the version it was issued with;
/// "Log out all devices" bumps it, which voids every older token at once.
model AuthSession {
  walletAddress String   @id @map("wallet_address") @db.VarChar(42)
  version       Int      @default(0)
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("auth_sessions")
}

/// Refresh tokens (httpOnly cookie dv_rt). Only the SHA-256 hash is stored. Every use rotates
/// it: usedAt is set and a new token is issued in the same family. A used token presented
/// again (after a 30s grace window for parallel tabs) means it was copied: the wallet's
/// tokens are all revoked.
model RefreshToken {
  id            String    @id @default(uuid()) @db.Uuid
  walletAddress String    @map("wallet_address") @db.VarChar(42)
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  familyId      String    @map("family_id") @db.Uuid
  expiresAt     DateTime  @map("expires_at")
  usedAt        DateTime? @map("used_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([expiresAt])

  @@index([walletAddress])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Background worker (src/worker.ts): the last block whose contract events were processed, per stream.
model ChainCursor {
  name      String   @id @db.VarChar(64)
  block     BigInt
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("chain_cursors")
}
