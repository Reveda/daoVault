NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/daovault?schema=public
JWT_SECRET=replace-with-a-long-random-secret
BSC_RPC_URL=https://bsc-dataseed.binance.org/
BSC_CHAIN_ID=56
TRUST_PROXY=1
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
FINANCIAL_RATE_LIMIT_WINDOW_MS=60000
FINANCIAL_RATE_LIMIT_MAX=20
LOG_REQUESTS=true
# Local-only dashboard fixture. Set this to your connected wallet before running db:seed:local.
SEED_WALLET_ADDRESS=
SEED_ACTIVE_DIRECTS=12
SEED_EARNED_USD=1450

# Add these only after the payment contract is deployed and verified.
# USDT_CONTRACT_ADDRESS=0x55d398326f99059fF775485246999027B3197955
# COMPANY_WALLET_ADDRESS=0xYOUR_COMPANY_TREASURY_WALLET
# PAYMENT_CONTRACT_ADDRESS=0xYOUR_DEPLOYED_PAYMENT_CONTRACT
# ACTIVATION_AMOUNT_USDT=300

# The backend verifies the on-chain Activated event before creating a package.
